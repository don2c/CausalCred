{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalcred.example/schemas/execution_provenance.schema.json",
  "title": "CausalCred execution provenance",
  "type": "object",
  "required": ["schema_version", "artifact_scope", "source", "execution", "runtime"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object",
      "required": ["algorithm", "source_revision_sha256", "source_file_count", "files"]
    },
    "execution": {
      "type": "object",
      "required": [
        "provider",
        "model_identifier",
        "decoding",
        "seed",
        "testbeds",
        "trials_per_family_per_testbed"
      ]
    }
  },
  "additionalProperties": true
}
